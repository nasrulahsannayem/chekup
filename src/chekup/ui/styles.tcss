/* Chekup TUI styles */

Screen {
    background: #080e1a;
}

#banner {
    height: 3;
    content-align: center middle;
    background: #142544;
    color: #ffffff;
    text-style: bold;
}

#metrics {
    height: 9;
    layout: grid;
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 1;
    margin: 0 1;
}

.metric {
    height: 9;
    border: round #315078;
    padding: 0 1;
    background: #101b2d;
}

#main {
    height: 1fr;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 1;
    margin: 0 1;
}

.panel {
    border: round #315078;
    padding: 0 1;
    background: #0d1728;
    height: 1fr;
}

#process {
    height: 1fr;
}

#alerts, #details {
    height: 1fr;
    overflow-y: auto;
}

#statusbar {
    height: 1;
    background: #142544;
    color: #b9d5ff;
    content-align: center middle;
}

Screen {
    overflow-y: auto;
}

.compact #metrics {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    height: 10;
}

.compact .metric {
    height: 5;
    padding: 0 1;
}

.compact #main {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    height: 1fr;
}

.compact .panel {
    height: 1fr;
    min-height: 6;
}

.tiny #metrics {
    grid-size: 1 4;
    grid-columns: 1fr;
    height: auto;
}

.tiny .metric {
    height: 5;
}

.tiny #main {
    grid-size: 1 4;
    grid-columns: 1fr;
    grid-rows: auto auto auto auto;
    height: auto;
}

.tiny .panel {
    height: 12;
}
